#Create the Survival time to event variable
query = """
SELECT *,
        (DATE(dod) - diagnosis_date)*12 as pt_survival_time,
        CASE WHEN DATE(dod) IS NOT NULL THEN 1 ELSE 0 END AS event

FROM df_patients_age;
"""
df_patient_survival = ps.sqldf(query, locals())
print(df_patient_survival.info())
print(df_patient_survival.describe(include = 'all'))
print(df_patient_survival['event'].value_counts())
print(df_patient_survival['pt_survival_time'].describe())
print(df_patient_survival['pt_survival_time'].info())
plt.figure(figsize=(8, 5))
sns.histplot(df_patient_survival['pt_survival_time'], bins=30, kde=True)
plt.title("Patient Survival")
plt.xlabel("Survival Time (Month)")
plt.ylabel("Patients")
plt.show()


# Convert survival_time_months to float
df_patient_survival['pt_survival_time'] = df_patient_survival['pt_survival_time'].fillna(0)
# Filter patients into two age groups
age_60_below = df_patient_survival[df_patient_survival['Age'] < 60].copy()
age_60_above = df_patient_survival[df_patient_survival['Age'] >= 60].copy()
print(age_60_below['pt_survival_time'].describe())
plt.figure(figsize=(8, 5))
sns.histplot(age_60_below['pt_survival_time'], bins=30, kde=True)
plt.title("Patient Survival for Age below 60")
plt.xlabel("Survival Time (Month)")
plt.ylabel("Patients")
plt.show()



print(age_60_above['pt_survival_time'].describe())
plt.figure(figsize=(8, 5))
sns.histplot(age_60_above['pt_survival_time'], bins=30, kde=True)
plt.title("Patient Survival for Age at or above 60")
plt.xlabel("Survival Time (Month)")
plt.ylabel("Patients")
plt.show()



# Kaplan-Meier Curve
kmf = KaplanMeierFitter()
plt.figure(figsize=(8, 5))

for group, df in df_patient_survival.groupby(df_patient_survival['Age'] >= 60):
    label = "Age >= 60" if group else "Age < 60"
    kmf.fit(df['pt_survival_time'], event_observed=df['event'], label=label)
    kmf.plot()

plt.title("Kaplan-Meier Survival Curve by Age Group")
plt.xlabel("Months")
plt.ylabel("Survival Probability")
plt.show()



# Comparing median survival
# Median survival time for Age < 60
kmf.fit(age_60_below['pt_survival_time'], event_observed=age_60_below['event'])
median_survival_below_60 = kmf.median_survival_time_

# Median survival time for Age ≥ 60
kmf.fit(age_60_above['pt_survival_time'], event_observed=age_60_above['event'])
median_survival_above_60 = kmf.median_survival_time_

print(f"Median Survival (Age < 60): {median_survival_below_60:.2f} months")
print(f"Median Survival (Age ≥ 60): {median_survival_above_60:.2f} months")


# Log-Rank Test for Survival Difference
results = logrank_test(age_60_below['pt_survival_time'], age_60_above['pt_survival_time'],
                       event_observed_A=age_60_below['event'],
                       event_observed_B=age_60_above['event'])
print(f"Log-Rank Test p-value: {results.p_value:.4f}")








