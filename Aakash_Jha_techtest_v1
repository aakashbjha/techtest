## Business Rules

#* Breast cancer patients: Patients with an encounter in the diagnosis table with diagnosis_code matching regex pattern '^C50.*'
#
#* Initial diagnosis date: The earliest encounter in the diagnosis table with the relevant filters.
#
#* Follow up time: The duration of time between the initial diagnosis date and last encounter in the database for a given patient.
#
#* Intent to test rate: The percentage of patients who have an encounter in the biomarker table for the relevant biomarker. 
#
#* Tested rate: The percentage of patients who have an encounter in the biomarker table for the relevant biomarker with a valid test result.
#
#* Negativity rate: The percentage of patients who have an encounter in the biomarker table for the relevant biomarker with a negative result.
# First lets find the first instance of Breast cancer diagnosis for patients
# Join the patient and diagnosis tables to find all patients with Breast Cancer Diagnosis


query = """
SELECT a.*, b.diagnosis_code, DATE(b.diagnosis_date) as diagnosis_date
FROM patient a
INNER JOIN diagnosis b
ON a.patient_id = b.patient_id
AND b.diagnosis_code like 'C50%'
ORDER BY a.patient_id, b.diagnosis_date ASC;
"""
df_patients_with_BC = pd.read_sql_query(query, conn)
# Lets perform some EDA on this table
print(df_patients_with_BC.describe())
print(df_patients_with_BC['diagnosis_code'].value_counts())
print(df_patients_with_BC['gender'].value_counts())
# Lets see whats the range of diagnosis date we have here
print(df_patients_with_BC['diagnosis_date'].min())
print(df_patients_with_BC['diagnosis_date'].max())


# Finding the first diagnosis of BC for each patient
query = """
SELECT *
FROM
(
Select *,
       rank() OVER (PARTITION BY patient_id ORDER BY diagnosis_date ASC) AS rnk
FROM df_patients_with_BC 
)
WHERE rnk = 1
"""

df_first_diag_of_BC = ps.sqldf(query, locals())
print(df_first_diag_of_BC.describe(include='all'))
#EDA
print(df_first_diag_of_BC['gender'].value_counts())
print(df_first_diag_of_BC['dod'].value_counts())


query = """
SELECT *, CASE WHEN dob > dod THEN 1 ELSE 0 end as dob_anom,
          CASE WHEN diagnosis_date > DATE(dod) THEN 1 ELSE 0 end as diag_anom
FROM
df_first_diag_of_BC
WHERE dod < dob
OR DATE(dod) < diagnosis_date
"""
df_first_diag_of_BC_check = ps.sqldf(query, locals())
print(df_first_diag_of_BC_check.describe(include='all'))
print(df_first_diag_of_BC_check['diag_anom'].value_counts())


# Excluding patients who had a date of death prior to their first diagnosis
query = """
SELECT *
FROM
df_first_diag_of_BC
WHERE patient_id not in (SELECT distinct patient_id from df_first_diag_of_BC_check);
"""
df_first_diag_of_BC_filtered_dod = ps.sqldf(query, locals())
print(df_first_diag_of_BC_filtered_dod.describe(include='all'))


# Calculating followup time
# To find that out lets look at the final encounter for each patient, lets join all the tables
query = """
SELECT a.*, DATE(b.diagnosis_date) as diagnosis_date,
       DATE(c.test_date) as test_date
FROM patient a
INNER JOIN diagnosis b
ON a.patient_id = b.patient_id
INNER JOIN biomarker c
ON a.patient_id = c.patient_id;
"""
df_all_tables = pd.read_sql_query(query, conn)
print(df_all_tables.describe(include='all'))
query = """
SELECT patient_id,
       max(DATE(dod)) as max_dod,
       max(diagnosis_date) as max_diag,
       max(test_date) as max_test
       
       
FROM df_all_tables 
GROUP BY 1;
"""
df_last_encounter = ps.sqldf(query, locals())
query = """
SELECT *,
       CASE
           WHEN max_diag >= max_dod OR max_test >= max_dod THEN max_dod
           WHEN max_diag <= max_dod AND max_diag >= max_test THEN max_diag
           WHEN max_test <= max_dod AND max_test >= max_diag THEN max_test
           ELSE '9999-01-01'
       END AS last_encounter_dod
       
       
FROM df_last_encounter 
GROUP BY 1;
"""
df_last_encounter_final = ps.sqldf(query, locals())
print(df_last_encounter_final.describe(include='all'))
print(df_last_encounter_final['last_encounter_dod'].value_counts().sort_index())
print(df_last_encounter_final)


# Joining the last encounter to our final table post exclusions and calculating followup period
query = """
SELECT a.*,
       b.last_encounter_dod,
       (b.last_encounter_dod - a.diagnosis_date)*12 as followup_time
       
FROM df_first_diag_of_BC_filtered_dod a
INNER JOIN df_last_encounter_final b
ON a.patient_id = b.patient_id;
"""
df_followup_time = ps.sqldf(query, locals())
print(df_followup_time)
print(df_followup_time.describe(include='all'))
print(df_followup_time[['patient_id', 'last_encounter_dod', 'diagnosis_date', 'followup_time']].sort_values(by='followup_time'))


